<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:process id="headcount-plan-approval" name="Headcount Plan Proposal" isExecutable="true">
    <bpmn:startEvent id="Start" name="Create">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Activity_Requester_Review" />
    <bpmn:userTask id="Activity_Requester_Review" name="New Request" camunda:assignee="Requester" camunda:candidateGroups="ROLE_HR_EXEC">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="ActionsInput">${[
   {
	"label": "Cancel",
	"value": "CANCEL"
   },
   {
	"label": "Edit",
	"value": "EDIT"
   },
   {
	"label": "Submit",
	"value": "SUBMIT"
   }
]}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_Editted</bpmn:incoming>
      <bpmn:incoming>Flow_HR_Returned</bpmn:incoming>
      <bpmn:incoming>Flow_DIV_Returned</bpmn:incoming>
      <bpmn:incoming>Flow_BR_Returned</bpmn:incoming>
      <bpmn:incoming>Flow_GD_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Requester_Review" targetRef="Gateway_Requester_Decision" />
    <bpmn:exclusiveGateway id="Gateway_Requester_Decision" name="Requester submit?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Submitted</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cancelled</bpmn:outgoing>
      <bpmn:outgoing>Flow_Editted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Submitted" name="Submit" sourceRef="Gateway_Requester_Decision" targetRef="Activity_HR_Review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == "SUBMIT"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cancelled" name="Cancel" sourceRef="Gateway_Requester_Decision" targetRef="Event_Workflow_Cancelled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == "CANCEL"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_Complete_Workflow" name="Notificate for Document Service" camunda:delegateExpression="${workflowCompletedDelegate}">
      <bpmn:incoming>Flow_GD_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Complete_Workflow" targetRef="Event_Workflow_Approved" />
    <bpmn:endEvent id="Event_Workflow_Approved" name="Completed (Approved)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_Workflow_Cancelled" name="Closed">
      <bpmn:incoming>Flow_Cancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_General_Director_Review" name="GD" camunda:candidateGroups="ROLE_GD">
      <bpmn:incoming>Flow_BR_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_16z4e70</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_HR_Review" name="HR Manager" camunda:candidateGroups="ROLE_HR_MANAGER">
      <bpmn:incoming>Flow_Submitted</bpmn:incoming>
      <bpmn:outgoing>Flow_1t50sby</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HR_Decision" name="HR Manager approve?">
      <bpmn:incoming>Flow_1t50sby</bpmn:incoming>
      <bpmn:outgoing>Flow_HR_Returned</bpmn:outgoing>
      <bpmn:outgoing>Flow_HR_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_HR_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1t50sby" sourceRef="Activity_HR_Review" targetRef="Gateway_HR_Decision" />
    <bpmn:sequenceFlow id="Flow_Editted" name="Edit" sourceRef="Gateway_Requester_Decision" targetRef="Activity_Requester_Review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == "EDIIT"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HR_Returned" name="Return" sourceRef="Gateway_HR_Decision" targetRef="Activity_Requester_Review" />
    <bpmn:endEvent id="Event_Workflow_Rejected" name="Rejected">
      <bpmn:incoming>Flow_HR_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_DIV_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_BR_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_GD_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_HR_Rejected" name="Reject" sourceRef="Gateway_HR_Decision" targetRef="Event_Workflow_Rejected" />
    <bpmn:sequenceFlow id="Flow_HR_Approved" name="Approve" sourceRef="Gateway_HR_Decision" targetRef="Activity_DIV_Director_Review" />
    <bpmn:userTask id="Activity_DIV_Director_Review" name="Dvision Director" camunda:candidateGroups="ROLE_DIV_DIRECTOR">
      <bpmn:incoming>Flow_HR_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_0gk12w0</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_DIV_Rejected" name="Reject" sourceRef="Gateway_12ivlfh" targetRef="Event_Workflow_Rejected" />
    <bpmn:exclusiveGateway id="Gateway_12ivlfh">
      <bpmn:incoming>Flow_0gk12w0</bpmn:incoming>
      <bpmn:outgoing>Flow_DIV_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_DIV_Returned</bpmn:outgoing>
      <bpmn:outgoing>Flow_DIV_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0gk12w0" sourceRef="Activity_DIV_Director_Review" targetRef="Gateway_12ivlfh" />
    <bpmn:sequenceFlow id="Flow_DIV_Returned" name="Return" sourceRef="Gateway_12ivlfh" targetRef="Activity_Requester_Review" />
    <bpmn:userTask id="Activity_BR_Director_Review" name="Branch Director" camunda:candidateGroups="ROLE_BR_DIRECTOR">
      <bpmn:incoming>Flow_DIV_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_0221bgq</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_DIV_Approved" name="Approve" sourceRef="Gateway_12ivlfh" targetRef="Activity_BR_Director_Review" />
    <bpmn:exclusiveGateway id="Gateway_1455ie3">
      <bpmn:incoming>Flow_0221bgq</bpmn:incoming>
      <bpmn:outgoing>Flow_BR_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_BR_Returned</bpmn:outgoing>
      <bpmn:outgoing>Flow_BR_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0221bgq" sourceRef="Activity_BR_Director_Review" targetRef="Gateway_1455ie3" />
    <bpmn:sequenceFlow id="Flow_BR_Rejected" name="Reject" sourceRef="Gateway_1455ie3" targetRef="Event_Workflow_Rejected" />
    <bpmn:sequenceFlow id="Flow_BR_Returned" name="Return" sourceRef="Gateway_1455ie3" targetRef="Activity_Requester_Review" />
    <bpmn:sequenceFlow id="Flow_BR_Approved" name="Approve" sourceRef="Gateway_1455ie3" targetRef="Activity_General_Director_Review" />
    <bpmn:exclusiveGateway id="Gateway_1s6rj0h">
      <bpmn:incoming>Flow_16z4e70</bpmn:incoming>
      <bpmn:outgoing>Flow_GD_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_GD_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_GD_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_16z4e70" sourceRef="Activity_General_Director_Review" targetRef="Gateway_1s6rj0h" />
    <bpmn:sequenceFlow id="Flow_GD_Rejected" name="Reject" sourceRef="Gateway_1s6rj0h" targetRef="Event_Workflow_Rejected" />
    <bpmn:sequenceFlow id="Flow_GD_Approved" name="Approve" sourceRef="Gateway_1s6rj0h" targetRef="Activity_Complete_Workflow" />
    <bpmn:sequenceFlow id="Flow_GD_Return" name="Return" sourceRef="Gateway_1s6rj0h" targetRef="Activity_Requester_Review" />
  </bpmn:process>
